SECRET_KEY=generate-a-unique-random-value
DATABASE_URL=sqlite:///campusconnect.db
STORAGE_BACKEND=local
ADMIN_USERNAME=
ADMIN_PASSWORD=

# For Supabase hosted PostgreSQL and Storage:
# Set DATABASE_URL to the Supabase PostgreSQL connection URL, then uncomment:
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-side-service-role-key

# Optional comma-separated browser origins for a separate frontend.
CORS_ORIGINS=
